# Generate two independent secrets as described in docs/self-hosting.md#install-with-compose.
STRIDE_COACH_API_TOKEN=replace-me-with-a-generated-secret
POSTGRES_PASSWORD=replace-me-with-a-different-generated-secret
POSTGRES_USER=stride
POSTGRES_DB=stride
# Optional external PostgreSQL. Leave unset for the bundled database.
# URL-encode special characters in credentials. Compose-generated secrets should be hex.
# DATABASE_URL=postgresql+psycopg://stride:GENERATED_PASSWORD@postgres:5432/stride
# Optional phone-facing HTTPS URL, used by stride-coach pair.
STRIDE_COACH_PUBLIC_URL=
STRIDE_COACH_TOKENS=/data/garmin
TZ=UTC
# Host port and address. Container always listens on 8000.
PORT=8000
BIND_ADDRESS=127.0.0.1
# Comma-separated exact web origins, no trailing slash. Native apps do not require CORS.
STRIDE_COACH_CORS_ORIGINS=
# Automatic Garmin reads. Daily time uses TZ; reconnect never retries a password login.
STRIDE_COACH_SYNC_ENABLED=true
STRIDE_COACH_SYNC_TIME=06:00
# Minimum interval between app-open sync attempts, shared across devices.
STRIDE_COACH_SYNC_OPEN_HOURS=6
# Minimum seconds between committed history pages (100 runs per page).
STRIDE_COACH_IMPORT_PAGE_DELAY=1


# Original FIT archive volume (named volume or absolute host directory).
STRIDE_COACH_FIT_VOLUME=run-originals
# false omits GPS, raw summaries, and original FIT on future imports/captures.
STRIDE_COACH_STORE_GPS=true
STRIDE_COACH_DETAIL_DELAY_SECONDS=1

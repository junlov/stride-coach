{
  "expo": {
    "name": "Stride Coach",
    "slug": "stride-coach",
    "owner": "junlov",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "org.stridecoach.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "org.stridecoach.app"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-build-properties",
        {
          "ios": {
            "enableSceneSupport": true
          }
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Stride Coach to scan your server pairing QR code.",
          "recordAudioAndroid": false,
          "microphonePermission": false
        }
      ]
    ],
    "scheme": ["stride-coach", "stridecoach"],
    "platforms": ["ios", "android"],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "1292c8fc-a736-43a2-be85-a0fb899f9475"
      }
    }
  }
}
